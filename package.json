{
  "name": "hucad",
  "version": "0.2.2",
  "private": true,
  "description": "HuCAD: offline, local Tinkercad-style Arduino circuit simulator",
  "author": "BIT-CT, CTU-San Francisco",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "fetch:toolchain": "node scripts/fetch-toolchain.mjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:electron": "node scripts/verify-electron.mjs",
    "toolchain:verify": "node scripts/fetch-toolchain.mjs --verify",
    "prebuild:linux": "node scripts/fetch-toolchain.mjs",
    "prebuild:win": "node scripts/fetch-toolchain.mjs"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "6.0.3",
    "@uiw/react-codemirror": "4.25.12",
    "avr8js": "0.21.1",
    "konva": "10.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "desktopName": "hucad.desktop"
}
