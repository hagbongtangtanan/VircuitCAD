{
  "name": "vircuitcad",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:fast": "pnpm -r --if-present test:fast",
    "build": "pnpm -r --if-present build",
    "dev:web": "pnpm --filter @vircuitcad/dev-server dev",
    "dev:desktop": "pnpm --filter @vircuitcad/desktop dev",
    "test:e2e": "playwright test",
    "e2e:screens": "playwright test e2e/screens.spec.ts",
    "check:licenses": "node tools/license-check/check.mjs",
    "bench": "tsx tools/bench.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/rbush": "4.0.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.17"
    }
  }
}
