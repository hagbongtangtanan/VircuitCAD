{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/PROGRESS.md"],
  "autoupdate": "notify",
  "share": "disabled",
  "compaction": { "auto": true, "prune": true, "reserved": 20000 },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", "out/**", ".git/**", ".vc/**", "coverage/**", "resources/toolchain/**"]
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "git add*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git checkout main*": "deny",
      "git switch main*": "deny",
      "git config*": "deny",
      "git rebase*": "deny",
      "git branch -D*": "deny",
      "gh pr merge*": "deny",
      "gh repo delete*": "deny",
      "sudo *": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "rm -rf .git*": "deny",
      "curl * | *": "deny",
      "wget * | *": "deny"
    }
  }
}
