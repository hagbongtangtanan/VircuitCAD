#!/usr/bin/env bash
# Blocks secrets, binaries and large files (toolchain/installers must never be committed).
max=$((5*1024*1024))
while IFS= read -r f; do
  [ -f "$f" ] || continue
  case "$f" in *.example|*.md) continue;; esac
  case "$f" in
    *.env|*.env.*|*.pem|*.pfx|*.p12|*id_rsa*) echo "✖ secret-like file: $f"; exit 1;;
    resources/toolchain/*|*.exe|*.dll|*.node|*.msi) echo "✖ binary must not be committed: $f"; exit 1;;
  esac
  size=$(wc -c <"$f")
  if [ "$size" -gt "$max" ]; then echo "✖ $f is larger than 5 MB"; exit 1; fi
done < <(git diff --cached --name-only --diff-filter=ACM)
