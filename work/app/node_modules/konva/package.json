{
  "name": "konva",
  "version": "10.9.0",
  "description": "HTML5 2d canvas library for interactive graphics, design editors, whiteboards, and diagrams.",
  "author": "Anton Lavrenov",
  "type": "module",
  "files": [
    "README.md",
    "konva.js",
    "konva.min.js",
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./lib/*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    },
    "./lib/*.js": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    },
    "./canvas-backend": {
      "types": "./lib/canvas-backend.d.ts",
      "default": "./lib/canvas-backend.js"
    },
    "./skia-backend": {
      "types": "./lib/skia-backend.d.ts",
      "default": "./lib/skia-backend.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "targets": {
    "none": {}
  },
  "funding": [
    {
      "type": "patreon",
      "url": "https://www.patreon.com/lavrton"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/konva"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/lavrton"
    }
  ],
  "devDependencies": {
    "@parcel/transformer-image": "2.15.4",
    "@types/mocha": "^10.0.10",
    "canvas": "^3.2.1",
    "chai": "6.2.2",
    "gulp": "^5.0.1",
    "gulp-connect": "^5.7.0",
    "gulp-jsdoc3": "^3.0.0",
    "gulp-rename": "^2.1.0",
    "gulp-replace": "^1.1.4",
    "gulp-uglify-es": "^3.0.0",
    "gulp-util": "^3.0.8",
    "mocha": "^10",
    "mocha-headless-chrome": "^4.0.0",
    "parcel": "2.15.4",
    "prettier": "^3.7.4",
    "process": "^0.11.10",
    "rimraf": "^6.1.2",
    "rollup": "^4.55.1",
    "rollup-plugin-typescript2": "^0.37.0",
    "skia-canvas": "^3.0.4",
    "stats.js": "0.17.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "canvas": "^3.0.0",
    "skia-canvas": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "canvas": {
      "optional": true
    },
    "skia-canvas": {
      "optional": true
    }
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "homepage": "https://konvajs.org/",
  "readmeFilename": "README.md",
  "repository": {
    "type": "git",
    "url": "git://github.com/konvajs/konva.git"
  },
  "license": "MIT"
}