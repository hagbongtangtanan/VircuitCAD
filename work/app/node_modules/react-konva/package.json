{
  "license": "MIT",
  "name": "react-konva",
  "description": "React components for the Konva 2d canvas library. Build interactive graphics, design editors, and whiteboards with JSX.",
  "homepage": "https://konvajs.org/docs/react/index.html",
  "version": "19.3.2",
  "main": "lib/ReactKonva.js",
  "module": "es/ReactKonva.js",
  "exports": {
    ".": {
      "import": {
        "types": "./es/ReactKonvaCore.d.ts",
        "default": "./es/ReactKonva.js"
      },
      "require": {
        "types": "./lib/ReactKonvaCore.d.ts",
        "default": "./lib/ReactKonva.js"
      }
    },
    "./lib/*.js": {
      "import": "./es/*.js",
      "require": "./lib/*.js"
    },
    "./lib/*.d.ts": "./lib/*.d.ts",
    "./lib/*": {
      "import": "./es/*.js",
      "require": "./lib/*.js"
    },
    "./es/*.js": "./es/*.js",
    "./es/*.d.ts": "./es/*.d.ts",
    "./es/package.json": "./es/package.json",
    "./es/*": "./es/*.js",
    "./*": "./*"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/konvajs/react-konva.git"
  },
  "dependencies": {
    "@types/react-reconciler": "0.34.0",
    "its-fine": "^2.1.1",
    "react-reconciler": "0.34.0",
    "scheduler": "0.28.0"
  },
  "funding": [
    {
      "type": "patreon",
      "url": "https://www.patreon.com/lavrton"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/konva"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/lavrton"
    }
  ],
  "peerDependencies": {
    "konva": "^8.0.1 || ^7.2.5 || ^9.0.0 || ^10.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@vitest/browser": "^5.0.4",
    "@vitest/browser-playwright": "^5.0.4",
    "konva": "^10.9.0",
    "mobx": "^7.0.6",
    "mobx-react-lite": "^5.1.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "use-image": "^1.1.4",
    "vitest": "^5.0.4"
  },
  "typings": "ReactKonvaCore.d.ts",
  "files": [
    "README.md",
    "docs/react-compatibility.md",
    "RELEASE_NOTES.md",
    "lib",
    "es",
    "ReactKonvaCore.d.ts"
  ]
}