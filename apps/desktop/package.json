{
  "name": "@vircuitcad/desktop",
  "version": "0.0.0",
  "description": "VircuitCAD desktop app (Electron shell)",
  "author": "VircuitCAD",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:fast": "vitest run --tagsFilter '!slow && !golden && !e2e && !toolchain'"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vircuitcad/core": "workspace:*",
    "@vircuitcad/editor": "workspace:*",
    "@vircuitcad/toolchain": "workspace:*",
    "@vircuitcad/ui": "workspace:*",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.6"
  }
}
