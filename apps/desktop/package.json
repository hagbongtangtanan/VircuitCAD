{
  "name": "@vircuitcad/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:fast": "vitest run --tagsFilter '!slow && !golden && !e2e && !toolchain'"
  },
  "dependencies": {
    "@vircuitcad/core": "workspace:*",
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.2.3",
    "esbuild": "0.28.2",
    "vite": "8.3.6"
  }
}
