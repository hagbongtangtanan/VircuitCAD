{
  "name": "@vircuitcad/dev-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx src/dev.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:fast": "vitest run --tagsFilter '!slow && !golden && !e2e && !toolchain'"
  },
  "dependencies": {
    "@vircuitcad/core": "workspace:*",
    "@vircuitcad/toolchain": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "vite": "8.3.6"
  }
}
