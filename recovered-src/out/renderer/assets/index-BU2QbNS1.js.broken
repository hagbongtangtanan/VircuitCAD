  '{\r\n  "format": "vircuit-project",\r\n  "version": 2,\r\n  "circuit": {\r\n    "version": 1,\r\n    "parts": [\r\n      {\r\n        "id": "uno",\r\n        "type": "arduino-uno",\r\n        "position": {\r\n          "x": 80,\r\n          "y": 120\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      },\r\n      {\r\n        "id": "bz1",\r\n        "type": "buzzer",\r\n        "position": {\r\n          "x": 500,\r\n          "y": 220\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      }\r\n    ],\r\n    "wires": [\r\n      {\r\n        "id": "w1",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "D8"\r\n        },\r\n        "to": {\r\n          "partId": "bz1",\r\n          "pinId": "plus"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w2",\r\n        "from": {\r\n          "partId": "bz1",\r\n          "pinId": "minus"\r\n        },\r\n        "to": {\r\n          "partId": "uno",\r\n          "pinId": "GND"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      }\r\n    ]\r\n  },\r\n  "sketch": "// Piezo buzzer on D8.\\nconst int buzzerPin = 8;\\n\\nvoid setup() {\\n  pinMode(buzzerPin, OUTPUT);\\n}\\n\\nvoid loop() {\\n  tone(buzzerPin, 880, 200);\\n  delay(1000);\\n  tone(buzzerPin, 660, 200);\\n  delay(1000);\\n}\\n",\r\n  "metadata": {\r\n    "created_at": "2026-10-25T00:00:00.000Z",\r\n    "app_version": "0.5.0-beta.2"\r\n  },\r\n  "viewport": {\r\n    "scale": 1,\r\n    "offsetX": 40,\r\n    "offsetY": 40\r\n  },\r\n  "name": "Buzzer alarm"\r\n}\r\n';
