var BREADBOARD_TOP_ROWS = ["a", "b", "c", "d", "e"];
var BREADBOARD_BOTTOM_ROWS = ["f", "g", "h", "i", "j"];
var BREADBOARD_COLUMN_PITCH = 10;
var BREADBOARD_FIRST_COLUMN_X = 30;
var BREADBOARD_ROW_PITCH = 10;
var BREADBOARD_TOP_ROW_Y = 60;
var BREADBOARD_BOTTOM_ROW_Y = 120;
var BREADBOARD_TOP_PLUS_Y = 30;
var BREADBOARD_TOP_MINUS_Y = 40;
var BREADBOARD_BOTTOM_PLUS_Y = 210;
var BREADBOARD_BOTTOM_MINUS_Y = 220;
var BREADBOARD_THEME = {
  bodyTop: "#EFEBDD",
  bodyBottom: "#E3DECB",
  border: "#B9B29C",
  bodyHighlight: "#F7F4EA",
  channel: "#A9A394",
  channelEdge: "#7C776B",
  holeInner: "#2A2F36",
  holeRim: "#F7F4EA",
  holeShadow: "#11151A",
  railPlus: "#D64545",
  railMinus: "#2F6FD6",
  hover: "#3BC9F5",
  connected: "#3DDC84",
  error: "#FF4D4F",
  label: "#5F5A4F",
  labelMuted: "#8A8578",
};
var BREADBOARD_DARK_THEME = {
  ...BREADBOARD_THEME,
  bodyTop: "#D8D5CC",
  bodyBottom: "#C9C5B9",
  border: "#8D887B",
  bodyHighlight: "#F2F0E9",
  channel: "#777368",
  channelEdge: "#545149",
  label: "#46433B",
  labelMuted: "#6F6A60",
};
var BREADBOARD_SIZING = {
  holeSize: 6.4,
  holeRadius: 1.1,
  railGap: 8,
  railGroupSize: 5,
  railGroupGap: 4,
  minLabelScale: 0.45,
};
/**
 * Body geometry derived from the pin grid, so the drawn board can never drift
 * away from where the holes actually are.
 */
var BREADBOARD_LAYOUT = {
  size: {
    width: 510,
    height: 240,
  },
  firstColumnX: BREADBOARD_FIRST_COLUMN_X,
  columnPitch: BREADBOARD_COLUMN_PITCH,
  rails: [
    {
      y: BREADBOARD_TOP_PLUS_Y,
      stripeY: BREADBOARD_TOP_PLUS_Y - BREADBOARD_SIZING.railGap,
      color: BREADBOARD_THEME.railPlus,
      label: "+",
    },
    {
      y: BREADBOARD_TOP_MINUS_Y,
      stripeY: BREADBOARD_TOP_MINUS_Y + BREADBOARD_SIZING.railGap,
      color: BREADBOARD_THEME.railMinus,
      label: "−",
    },
    {
      y: BREADBOARD_BOTTOM_PLUS_Y,
      stripeY: BREADBOARD_BOTTOM_PLUS_Y - BREADBOARD_SIZING.railGap,
      color: BREADBOARD_THEME.railPlus,
      label: "+",
    },
    {
      y: BREADBOARD_BOTTOM_MINUS_Y,
      stripeY: BREADBOARD_BOTTOM_MINUS_Y + BREADBOARD_SIZING.railGap,
      color: BREADBOARD_THEME.railMinus,
      label: "−",
    },
  ],
  halves: [
    {
      top: 62,
      bottom: 118,
    },
    {
      top: 122,
      bottom: 178,
    },
  ],
};
function breadboardColumnX(column) {
  return BREADBOARD_FIRST_COLUMN_X + (column - 1) * BREADBOARD_COLUMN_PITCH;
}
function breadboardRowY(rowIndex, firstRowY) {
  return firstRowY + (rowIndex - 1) * BREADBOARD_ROW_PITCH;
}
function buildBreadboardPins() {
  const pins = [];
  for (let column = 1; column <= 45; column += 1) {
    const x = breadboardColumnX(column);
    for (const [index, row] of BREADBOARD_TOP_ROWS.entries())
      pins.push(
        pin(`${row}${column}`, `${row}${column}`, {
          x,
          y: breadboardRowY(index + 1, BREADBOARD_TOP_ROW_Y),
        }),
      );
    for (const [index, row] of BREADBOARD_BOTTOM_ROWS.entries())
      pins.push(
        pin(`${row}${column}`, `${row}${column}`, {
          x,
          y: breadboardRowY(index + 1, BREADBOARD_BOTTOM_ROW_Y),
        }),
      );
  }
  const rails = [
    {
      prefix: "top-plus",
      label: "+",
      y: BREADBOARD_TOP_PLUS_Y,
      kind: "power",
    },
    {
      prefix: "top-minus",
      label: "−",
      y: BREADBOARD_TOP_MINUS_Y,
      kind: "ground",
    },
    {
      prefix: "bottom-plus",
      label: "+",
      y: BREADBOARD_BOTTOM_PLUS_Y,
      kind: "power",
    },
    {
      prefix: "bottom-minus",
      label: "−",
      y: BREADBOARD_BOTTOM_MINUS_Y,
      kind: "ground",
    },
  ];
  for (const rail of rails)
    for (let column = 1; column <= 45; column += 1)
      pins.push(
        pin(
          `${rail.prefix}-${column}`,
          rail.label,
          {
            x: breadboardColumnX(column),
            y: rail.y,
          },
          rail.kind,
        ),
      );
  return pins;
}
function buildBreadboardInternalNets() {
  const nets = [];
  for (let column = 1; column <= 45; column += 1) {
    nets.push(BREADBOARD_TOP_ROWS.map((row) => `${row}${column}`));
    nets.push(BREADBOARD_BOTTOM_ROWS.map((row) => `${row}${column}`));
  }
  for (const prefix of ["top-plus", "top-minus", "bottom-plus", "bottom-minus"])
    nets.push(
      Array.from({ length: 45 }, (_unused, index) => `${prefix}-${index + 1}`),
    );
  return nets;
}
