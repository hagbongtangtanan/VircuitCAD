//#region src/starters/uno-lcd-hello.vcc?raw
var uno_lcd_hello_default =
  '{\r\n  "format": "vircuit-project",\r\n  "version": 2,\r\n  "circuit": {\r\n    "version": 1,\r\n    "parts": [\r\n      {\r\n        "id": "uno",\r\n        "type": "arduino-uno",\r\n        "position": {\r\n          "x": 60,\r\n          "y": 120\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      },\r\n      {\r\n        "id": "lcd1",\r\n        "type": "lcd-16x2-i2c",\r\n        "position": {\r\n          "x": 500,\r\n          "y": 220\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      }\r\n    ],\r\n    "wires": [\r\n      {\r\n        "id": "w1",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "GND"\r\n        },\r\n        "to": {\r\n          "partId": "lcd1",\r\n          "pinId": "gnd"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w2",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "5V"\r\n        },\r\n        "to": {\r\n          "partId": "lcd1",\r\n          "pinId": "vcc"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w3",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "A4"\r\n        },\r\n        "to": {\r\n          "partId": "lcd1",\r\n          "pinId": "sda"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w4",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "A5"\r\n        },\r\n        "to": {\r\n          "partId": "lcd1",\r\n          "pinId": "scl"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      }\r\n    ]\r\n  },\r\n  "sketch": "// 16x2 LCD with a PCF8574 I2C backpack at 0x27 (SDA A4, SCL A5).\\n#include <Wire.h>\\n\\nconst uint8_t LCD_ADDR = 0x27;\\nconst uint8_t BACKLIGHT = 0x08;\\nconst uint8_t ENABLE = 0x04;\\nconst uint8_t RS = 0x01;\\n\\nvoid lcdWrite(uint8_t value) {\\n  Wire.beginTransmission(LCD_ADDR);\\n  Wire.write(value);\\n  Wire.endTransmission();\\n}\\n\\nvoid lcdPulse(uint8_t value) {\\n  lcdWrite(value | ENABLE);\\n  delayMicroseconds(1);\\n  lcdWrite(value & ~ENABLE);\\n  delayMicroseconds(50);\\n}\\n\\nvoid lcdNibble(uint8_t nibble, bool isData) {\\n  lcdPulse((nibble << 4) | BACKLIGHT | (isData ? RS : 0));\\n}\\n\\nvoid lcdSend(uint8_t value, bool isData) {\\n  lcdNibble(value >> 4, isData);\\n  lcdNibble(value & 0x0F, isData);\\n}\\n\\nvoid lcdCommand(uint8_t command) { lcdSend(command, false); }\\nvoid lcdData(uint8_t value) { lcdSend(value, true); }\\n\\nvoid lcdBegin() {\\n  Wire.begin();\\n  delay(50);\\n  lcdNibble(0x03, false); delay(5);\\n  lcdNibble(0x03, false); delay(1);\\n  lcdNibble(0x03, false); delay(1);\\n  lcdNibble(0x02, false);\\n  lcdCommand(0x28);\\n  lcdCommand(0x0C);\\n  lcdCommand(0x06);\\n  lcdCommand(0x01);\\n  delay(2);\\n}\\n\\nvoid lcdPrint(const char* text) {\\n  while (*text) lcdData((uint8_t)*text++);\\n}\\n\\nvoid setup() {\\n  lcdBegin();\\n  lcdPrint(\\"Hello, Vircuit!\\");\\n}\\n\\nvoid loop() {}\\n",\r\n  "metadata": {\r\n    "created_at": "2026-10-25T00:00:00.000Z",\r\n    "app_version": "0.5.0-beta.2"\r\n  },\r\n  "viewport": {\r\n    "scale": 1,\r\n    "offsetX": 40,\r\n    "offsetY": 40\r\n  },\r\n  "name": "Hello on an LCD"\r\n}\r\n';
//#endregion
