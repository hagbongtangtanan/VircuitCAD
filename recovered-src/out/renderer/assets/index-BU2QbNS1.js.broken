v1",\r\n          "pinId": "6"\r\n        },\r\n        "to": {\r\n          "partId": "m1",\r\n          "pinId": "minus"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w6",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "5V"\r\n        },\r\n        "to": {\r\n          "partId": "drv1",\r\n          "pinId": "8"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w7",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "5V"\r\n        },\r\n        "to": {\r\n          "partId": "drv1",\r\n          "pinId": "16"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w8",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "GND"\r\n        },\r\n        "to": {\r\n          "partId": "drv1",\r\n          "pinId": "4"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w9",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "GND2"\r\n        },\r\n        "to": {\r\n          "partId": "drv1",\r\n          "pinId": "5"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      }\r\n    ]\r\n  },\r\n  "sketch": "// L293D: EN1 -> D5, IN1 -> D2, IN2 -> D3, OUT1/OUT2 -> motor.\\nconst int enablePin = 5;\\nconst int in1Pin = 2;\\nconst int in2Pin = 3;\\n\\nvoid setup() {\\n  pinMode(enablePin, OUTPUT);\\n  pinMode(in1Pin, OUTPUT);\\n  pinMode(in2Pin, OUTPUT);\\n  analogWrite(enablePin, 180);\\n}\\n\\nvoid loop() {\\n  digitalWrite(in1Pin, HIGH);\\n  digitalWrite(in2Pin, LOW);\\n  delay(2000);\\n\\n  digitalWrite(in1Pin, LOW);\\n  digitalWrite(in2Pin, HIGH);\\n  delay(2000);\\n\\n  digitalWrite(in1Pin, LOW);\\n  digitalWrite(in2Pin, LOW);\\n  delay(1000);\\n}\\n",\r\n  "metadata": {\r\n    "created_at": "2026-10-25T00:00:00.000Z",\r\n    "app_version": "0.5.0-beta.2"\r\n  },\r\n  "viewport": {\r\n    "scale": 1,\r\n    "offsetX": 40,\r\n    "offsetY": 40\r\n  },\r\n  "name": "Drive a DC motor"\r\n}\r\n';
