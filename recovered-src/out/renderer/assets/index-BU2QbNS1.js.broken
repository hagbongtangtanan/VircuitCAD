    "pinId": "lead2"\r\n        },\r\n        "to": {\r\n          "partId": "uno",\r\n          "pinId": "GND"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w4",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "D2"\r\n        },\r\n        "to": {\r\n          "partId": "sw1",\r\n          "pinId": "2"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w5",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "D13"\r\n        },\r\n        "to": {\r\n          "partId": "r2",\r\n          "pinId": "lead1"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w6",\r\n        "from": {\r\n          "partId": "r2",\r\n          "pinId": "lead2"\r\n        },\r\n        "to": {\r\n          "partId": "led1",\r\n          "pinId": "anode"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w7",\r\n        "from": {\r\n          "partId": "led1",\r\n          "pinId": "cathode"\r\n        },\r\n        "to": {\r\n          "partId": "uno",\r\n          "pinId": "GND"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      }\r\n    ]\r\n  },\r\n  "sketch": "// Slide Switch: pin 1 -> 5V, pin 2 -> D2 with 10kΩ pull-down to GND\\n// LED on D13 shows switch state\\nconst int switchPin = 2;\\nconst int ledPin = 13;\\n\\nvoid setup() {\\n  pinMode(switchPin, INPUT);\\n  pinMode(ledPin, OUTPUT);\\n  Serial.begin(9600);\\n}\\n\\nvoid loop() {\\n  int state = digitalRead(switchPin);\\n  digitalWrite(ledPin, state);\\n  Serial.print(\\"Switch: \\");\\n  Serial.println(state ? \\"ON\\" : \\"OFF\\");\\n  delay(200);\\n}\\n",\r\n  "metadata": {\r\n    "created_at": "2026-10-25T00:00:00.000Z",\r\n    "app_version": "0.5.0-beta.2"\r\n  },\r\n  "viewport": {\r\n    "scale": 