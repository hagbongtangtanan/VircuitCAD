var uno_millis_timer_default =
  '{\r\n  "format": "vircuit-project",\r\n  "version": 2,\r\n  "circuit": {\r\n    "version": 1,\r\n    "parts": [\r\n      {\r\n        "id": "uno",\r\n        "type": "arduino-uno",\r\n        "position": {\r\n          "x": 80,\r\n          "y": 120\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      },\r\n      {\r\n        "id": "r1",\r\n        "type": "resistor",\r\n        "position": {\r\n          "x": 480,\r\n          "y": 140\r\n        },\r\n        "rotation": 0,\r\n        "props": {\r\n          "resistanceOhms": 220\r\n        }\r\n      },\r\n      {\r\n        "id": "led1",\r\n        "type": "led",\r\n        "position": {\r\n          "x": 600,\r\n          "y": 160\r\n        },\r\n        "rotation": 0,\r\n        "props": {\r\n          "color": "blue"\r\n        }\r\n      }\r\n    ],\r\n    "wires": [\r\n      {\r\n        "id": "w1",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "D9"\r\n        },\r\n        "to": {\r\n          "partId": "r1",\r\n          "pinId": "lead1"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w2",\r\n        "from": {\r\n          "partId": "r1",\r\n          "pinId": "lead2"\r\n        },\r\n        "to": {\r\n          "partId": "led1",\r\n          "pinId": "anode"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w3",\r\n        "from": {\r\n          "partId": "led1",\r\n          "pinId": "cathode"\r\n        },\r\n        "to": {\r\n          "partId": "uno",\r\n          "pinId": "GND"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      }\r\n    ]\r\n  },\r\n  "sketch": "// Non-blocking timer: blink D9 with millis() instead of delay().\\nconst int ledPin = 9;\\nconst unsigned long interval = 250;\\nunsigned long previousMillis = 0;\\nbool ledOn = false;\\n\\nvoid setup() {\\n  pinMode(ledPin, OUTPUT);\\n  Serial.begin(9600);\\n}\\n\\nvoid loop() {\\n  unsigned long now = millis();\\n  if (now - previousMillis >= interval) {\\n    previousMillis = now;\\n    ledOn = !ledOn;\\n    digitalWrite(ledPin, ledOn ? HIGH : LOW);\\n    Serial.println(ledOn ? \\"LED on\\" : \\"LED off\\");\\n  }\\n}\\n",\r\n  "metadata": {\r\n    "created_at": "2026-10-25T00:00:00.000Z",\r\n    "app_version": "0.5.0-beta.2"\r\n  },\r\n  "viewport": {\r\n    "scale": 1,\r\n    "offsetX": 40,\r\n    "offsetY": 40\r\n  },\r\n  "name": "Millis timer"\r\n}\r\n';
//#endregion
