var uno_neopixel_ring_default =
  '{\r\n  "format": "vircuit-project",\r\n  "version": 2,\r\n  "circuit": {\r\n    "version": 1,\r\n    "parts": [\r\n      {\r\n        "id": "uno",\r\n        "type": "arduino-uno",\r\n        "position": {\r\n          "x": 80,\r\n          "y": 120\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      },\r\n      {\r\n        "id": "nr1",\r\n        "type": "neopixel-ring",\r\n        "position": {\r\n          "x": 500,\r\n          "y": 160\r\n        },\r\n        "rotation": 0,\r\n        "props": {\r\n          "pixelCount": 12,\r\n          "color": "blue"\r\n        }\r\n      }\r\n    ],\r\n    "wires": [\r\n      {\r\n        "id": "w1",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "5V"\r\n        },\r\n        "to": {\r\n          "partId": "nr1",\r\n          "pinId": "vdd"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w2",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "GND"\r\n        },\r\n        "to": {\r\n          "partId": "nr1",\r\n          "pinId": "gnd"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w3",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "D6"\r\n        },\r\n        "to": {\r\n          "partId": "nr1",\r\n          "pinId": "din"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      }\r\n    ]\r\n  },\r\n  "sketch": "// NeoPixel Ring (bit-bang): VDD -> 5V, GND -> GND, DIN -> D6\\n// WS2812 timing without Adafruit_NeoPixel library\\n#define PIN 6\\n#define NUMPIXELS 12\\n\\nvoid sendBit(bool bitVal) {\\n  if (bitVal) {\\n    PORTD |= (1 << PIN);\\n    __asm__ volatile (\\n      \\"nop\\\\n\\\\t nop\\\\n\\\\t nop\\\\n\\\\t nop\\\\n\\\\t nop\\\\n\\\\t nop\\\\n\\\\t\\"\\n      \\"nop\\\\n\\\\t nop\\\\n\\\\t nop\\\\n\\\\t nop\\\\n\\\\t nop\\\\n\\\\t\\"\\n      \\"nop\\\\n\\\\t nop\\\\n\\\\t nop\\\\n\\\\t nop\\\\n\\\\t nop\\\\n\\\\t\\"\\n    );\\n    PORTD &= ~(1 << PIN);\\n  } else {\\n    PORTD |= (1 << PIN);\\n    __asm__ volatile (\\"nop\\\\n\\\\t nop\\\\n\\\\t nop\\\\n\\\\t\\");\\n    PORTD &= ~(1 << PIN);\\n  }\\n}\\n\\nvoid sendByte(uint8_t b) {\\n  for (int i = 7; i >= 0; i--) sendBit(b & (1 << i));\\n}\\n\\nvoid setPixel(uint8_t r, uint8_t g, uint8_t b) {\\n  sendByte(g); sendByte(r); sendByte(b);\\n}\\n\\nvoid show() {\\n  PORTD &= ~(1 << PIN);\\n  delayMicroseconds(50);\\n}\\n\\nvoid setup() {\\n  pinMode(PIN, OUTPUT);\\n  digitalWrite(PIN, LOW);\\n}\\n\\nvoid loop() {\\n  for (int i = 0; i < NUMPIXELS; i++) {\\n    setPixel(0, 0, 150);\\n    show();\\n    delay(50);\\n    setPixel(0, 0, 0);\\n    show();\\n  }\\n}\\n",\r\n  "metadata": {\r\n    "created_at": "2026-10-25T00:00:00.000Z",\r\n    "app_version": "0.5.0-beta.2"\r\n  },\r\n  "viewport": {\r\n    "scale": 1,\r\n    "offsetX": 40,\r\n    "offsetY": 40\r\n  },\r\n  "name": "Control NeoPixel ring"\r\n}';
