var uno_ir_receiver_default =
  '{\r\n  "format": "vircuit-project",\r\n  "version": 2,\r\n  "circuit": {\r\n    "version": 1,\r\n    "parts": [\r\n      {\r\n        "id": "uno",\r\n        "type": "arduino-uno",\r\n        "position": {\r\n          "x": 80,\r\n          "y": 120\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      },\r\n      {\r\n        "id": "ir1",\r\n        "type": "ir-receiver",\r\n        "position": {\r\n          "x": 500,\r\n          "y": 160\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      }\r\n    ],\r\n    "wires": [\r\n      {\r\n        "id": "w1",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "5V"\r\n        },\r\n        "to": {\r\n          "partId": "ir1",\r\n          "pinId": "vcc"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w2",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "GND"\r\n        },\r\n        "to": {\r\n          "partId": "ir1",\r\n          "pinId": "gnd"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w3",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "D2"\r\n        },\r\n        "to": {\r\n          "partId": "ir1",\r\n          "pinId": "out"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      }\r\n    ]\r\n  },\r\n  "sketch": "// IR Receiver (raw): VCC -> 5V, GND -> GND, OUT -> D2\\n// Measures raw HIGH/LOW pulse widths; protocol decoding needs IRremote library\\nconst int recvPin = 2;\\nunsigned long lastChange = 0;\\nint lastState = HIGH;\\n\\nvoid setup() {\\n  pinMode(recvPin, INPUT);\\n  Serial.begin(9600);\\n}\\n\\nvoid loop() {\\n  int state = digitalRead(recvPin);\\n  if (state != lastState) {\\n    unsigned long now = micros();\\n    unsigned long duration = now - lastChange;\\n    if (lastState == LOW) {\\n      Serial.print(\\"Pulse: \\");\\n    } else {\\n      Serial.print(\\"Space: \\");\\n    }\\n    Serial.println(duration);\\n    lastChange = now;\\n    lastState = state;\\n  }\\n}\\n",\r\n  "metadata": {\r\n    "created_at": "2026-10-25T00:00:00.000Z",\r\n    "app_version": "0.5.0-beta.2"\r\n  },\r\n  "viewport": {\r\n    "scale": 1,\r\n    "offsetX": 40,\r\n    "offsetY": 40\r\n  },\r\n  "name": "Receive IR remote signals"\r\n}';
//#endregion
