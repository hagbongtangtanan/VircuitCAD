var definitionsByType = new Map(
  partDefinitions.map((definition) => [definition.type, definition]),
);
function definitionOf(type) {
  const definition = definitionsByType.get(type);
  if (definition === void 0)
    throw new Error(`No part definition registered for type "${type}"`);
  return definition;
}
function pinOf(type, pinId) {
  const found = definitionOf(type).pins.find(
    (candidate) => candidate.id === pinId,
  );
  if (found === void 0) throw new Error(`Part "${type}" has no pin "${pinId}"`);
  return found;
}
/** Pin offset from the part's top-left after mirroring, before rotation. */
function localPinPosition(part, pinId) {
  const definition = definitionOf(part.type);
  const local = pinOf(part.type, pinId);
  return {
    x:
      part.flipX === true
        ? definition.size.width - local.position.x
        : local.position.x,
    y:
      part.flipY === true
        ? definition.size.height - local.position.y
        : local.position.y,
  };
}
/** The pin definition with its mirrored position, for edge and label layout. */
function effectivePin(part, pin) {
  return {
    ...pin,
    position: localPinPosition(part, pin.id),
  };
}
/** Absolute world position of a pin, accounting for flipping and rotation. */
function pinWorldPosition(part, pinId) {
  const definition = definitionOf(part.type);
  const rotated = rotateOffset(
    localPinPosition(part, pinId),
    part.rotation,
    definition.size,
  );
  return {
    x: part.position.x + rotated.x,
    y: part.position.y + rotated.y,
  };
}
var NOTE_LINE_HEIGHT = 1.35;
var DEFAULT_NOTE_TEXT = "New note";
var NOTE_CHAR_WIDTH = 8.4;
function wrappedLineCount(line) {
  const charsPerLine = Math.max(8, Math.floor(196 / NOTE_CHAR_WIDTH));
  if (line.length === 0) return 1;
  return Math.max(1, Math.ceil(line.length / charsPerLine));
}
/** Approximate the wrapped height so the card grows with its text. */
function noteHeight(text) {
  const body =
    text.split("\n").reduce((sum, line) => sum + wrappedLineCount(line), 0) *
    14 *
    NOTE_LINE_HEIGHT;
  return Math.max(72, Math.ceil(24 + body));
