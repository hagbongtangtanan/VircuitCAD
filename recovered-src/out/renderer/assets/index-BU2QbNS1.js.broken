: {\r\n          "partId": "uno",\r\n          "pinId": "GND"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w9",\r\n        "from": {\r\n          "partId": "sr1",\r\n          "pinId": "1"\r\n        },\r\n        "to": {\r\n          "partId": "led2",\r\n          "pinId": "anode"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w13",\r\n        "from": {\r\n          "partId": "led2",\r\n          "pinId": "cathode"\r\n        },\r\n        "to": {\r\n          "partId": "uno",\r\n          "pinId": "GND"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w10",\r\n        "from": {\r\n          "partId": "sr1",\r\n          "pinId": "2"\r\n        },\r\n        "to": {\r\n          "partId": "led3",\r\n          "pinId": "anode"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w14",\r\n        "from": {\r\n          "partId": "led3",\r\n          "pinId": "cathode"\r\n        },\r\n        "to": {\r\n          "partId": "uno",\r\n          "pinId": "GND"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w11",\r\n        "from": {\r\n          "partId": "sr1",\r\n          "pinId": "3"\r\n        },\r\n        "to": {\r\n          "partId": "led4",\r\n          "pinId": "anode"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w15",\r\n        "from": {\r\n          "partId": "led4",\r\n          "pinId": "cathode"\r\n        },\r\n        "to": {\r\n          "partId": "uno",\r\n          "pinId": "GND"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      }\r\n    ]\r\n  },\r\n  "sketch": "// 74HC595: SER D2, SRCLK D3, RCLK D4. QA-QD drive four LEDs.\\nconst int dataPin = 2;\\nconst int clockPin = 3;\\nconst int latchPin = 4;\\n\\nvoid setup() {\\n  pinMode(dataPin, OUTPUT);\\n  pinMode(clockPin, OUTPUT);\\n  pinMode(latchPin, OUTPUT);\\n}\\n\\nvoid loop() {\\n  for (int value = 0; value < 16; value++) {\\n    digitalWrite(latchPin, LOW);\\n    shiftOut(dataPin, clockPin, MSBFIRST, value);\\n    digitalWrite(latchPin, HIGH);\\n    delay(300);\\n  }\\n}\\n",\r\n  "metadata": {\r\n    "created_at": "2026-10-25T00:00:00.000Z",\r\n    "app_version": "0.5.0-beta.2"\r\n  },\r\n  "viewport": {\r\n    "scale": 1,\r\n    "offsetX": 40,\r\n    "offsetY": 40\r\n  },\r\n  "name": "Shift register LEDs"\r\n}\r\n';
