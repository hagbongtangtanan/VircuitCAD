var uno_temperature_default =
  '{\r\n  "format": "vircuit-project",\r\n  "version": 2,\r\n  "circuit": {\r\n    "version": 1,\r\n    "parts": [\r\n      {\r\n        "id": "uno",\r\n        "type": "arduino-uno",\r\n        "position": {\r\n          "x": 80,\r\n          "y": 120\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      },\r\n      {\r\n        "id": "tmp1",\r\n        "type": "tmp36",\r\n        "position": {\r\n          "x": 500,\r\n          "y": 220\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      }\r\n    ],\r\n    "wires": [\r\n      {\r\n        "id": "w1",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "5V"\r\n        },\r\n        "to": {\r\n          "partId": "tmp1",\r\n          "pinId": "vcc"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w2",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "GND"\r\n        },\r\n        "to": {\r\n          "partId": "tmp1",\r\n          "pinId": "gnd"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w3",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "A0"\r\n        },\r\n        "to": {\r\n          "partId": "tmp1",\r\n          "pinId": "vout"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      }\r\n    ]\r\n  },\r\n  "sketch": "// TMP36: V+ -> 5V, GND -> GND, OUT -> A0\\nconst int sensorPin = A0;\\n\\nvoid setup() {\\n  Serial.begin(9600);\\n}\\n\\nvoid loop() {\\n  int reading = analogRead(sensorPin);\\n  float volts = reading * 5.0 / 1023.0;\\n  float celsius = (volts - 0.5) * 100.0;\\n  Serial.print(\\"Temperature: \\");\\n  Serial.print(celsius, 1);\\n  Serial.println(\\" C\\");\\n  delay(1000);\\n}\\n",\r\n  "metadata": {\r\n    "created_at": "2026-10-25T00:00:00.000Z",\r\n    "app_version": "0.5.0-beta.2"\r\n  },\r\n  "viewport": {\r\n    "scale": 1,\r\n    "offsetX": 40,\r\n    "offsetY": 40\r\n  },\r\n  "name": "Read a temperature"\r\n}\r\n';
