var uno_keypad_default =
  '{\r\n  "format": "vircuit-project",\r\n  "version": 2,\r\n  "circuit": {\r\n    "version": 1,\r\n    "parts": [\r\n      {\r\n        "id": "uno",\r\n        "type": "arduino-uno",\r\n        "position": {\r\n          "x": 80,\r\n          "y": 120\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      },\r\n      {\r\n        "id": "kp1",\r\n        "type": "keypad-4x4",\r\n        "position": {\r\n          "x": 500,\r\n          "y": 160\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      }\r\n    ],\r\n    "wires": [\r\n      {\r\n        "id": "w1",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "D2"\r\n        },\r\n        "to": {\r\n          "partId": "kp1",\r\n          "pinId": "r1"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w2",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "D3"\r\n        },\r\n        "to": {\r\n          "partId": "kp1",\r\n          "pinId": "r2"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w3",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "D4"\r\n        },\r\n        "to": {\r\n          "partId": "kp1",\r\n          "pinId": "r3"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w4",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "D5"\r\n        },\r\n        "to": {\r\n          "partId": "kp1",\r\n          "pinId": "r4"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w5",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "D6"\r\n        },\r\n        "to": {\r\n          "partId": "kp1",\r\n          "pinId": "c1"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w6",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "D7"\r\n        },\r\n        "to": {\r\n          "partId": "kp1",\r\n          "pinId": "c2"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w7",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "D8"\r\n        },\r\n        "to": {\r\n          "partId": "kp1",\r\n          "pinId": "c3"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w8",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "D9"\r\n        },\r\n        "to": {\r\n          "partId": "kp1",\r\n          "pinId": "c4"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      }\r\n    ]\r\n  },\r\n  "sketch": "// 4x4 Keypad (no library): Rows R1-R4 -> D2-D5, Cols C1-C4 -> D6-D9\\n// Manual matrix scanning without Keypad library\\nconst byte ROWS = 4;\\nconst byte COLS = 4;\\nchar keys[ROWS][COLS] = {\\n  {\'1\',\'2\',\'3\',\'A\'},\\n  {\'4\',\'5\',\'6\',\'B\'},\\n  {\'7\',\'8\',\'9\',\'C\'},\\n  {\'*\',\'0\',\'#\',\'D\'}\\n};\\nbyte rowPins[ROWS] = {2, 3, 4, 5};\\nbyte colPins[COLS] = {6, 7, 8, 9};\\n\\nvoid setup() {\\n  for (byte c = 0; c < COLS; c++) pinMode(colPins[c], OUTPUT);\\n  for (byte r = 0; r < ROWS; r++) pinMode(rowPins[r], INPUT_PULLUP);\\n  Serial.begin(9600);\\n}\\n\\nvoid loop() {\\n  for (byte c = 0; c < COLS; c++) {\\n    digitalWrite(colPins[c], LOW);\\n    for (byte r = 0; r < ROWS; r++) {\\n      if (digitalRead(rowPins[r]) == LOW) {\\n        Serial.print(\\"Key: \\");\\n        Serial.println(keys[r][c]);\\n        delay(300);\\n      }\\n    }\\n    digitalWrite(colPins[c], HIGH);\\n  }\\n}\\n",\r\n  "metadata": {\r\n    "created_at": "2026-10-25T00:00:00.000Z",\r\n    "app_version": "0.5.0-beta.2"\r\n  },\r\n  "viewport": {\r\n    "scale": 1,\r\n    "offsetX": 40,\r\n    "offsetY": 40\r\n  },\r\n  "name": "Read 4x4 keypad input"\r\n}';
