function dipPins(count, width) {
  const pitch = (width - 20) / Math.max(1, count - 1);
  return Array.from({ length: count }, (_unused, index) => {
    const x = 10 + index * pitch;
    return [
      pin(`top${index + 1}`, `${index + 1}`, {
        x,
        y: 0,
      }),
      pin(`bottom${index + 1}`, `${index + 1}`, {
        x,
        y: 36,
      }),
    ];
  }).flat();
}
