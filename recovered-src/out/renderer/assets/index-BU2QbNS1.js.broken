var uno_dc_motor_default =
  '{\r\n  "format": "vircuit-project",\r\n  "version": 2,\r\n  "circuit": {\r\n    "version": 1,\r\n    "parts": [\r\n      {\r\n        "id": "uno",\r\n        "type": "arduino-uno",\r\n        "position": {\r\n          "x": 80,\r\n          "y": 120\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      },\r\n      {\r\n        "id": "motor1",\r\n        "type": "dc-motor",\r\n        "position": {\r\n          "x": 500,\r\n          "y": 160\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      },\r\n      {\r\n        "id": "tip1",\r\n        "type": "tip120",\r\n        "position": {\r\n          "x": 580,\r\n          "y": 160\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      },\r\n      {\r\n        "id": "d1",\r\n        "type": "diode",\r\n        "position": {\r\n          "x": 500,\r\n          "y": 80\r\n        },\r\n        "rotation": 180,\r\n        "props": {}\r\n      },\r\n      {\r\n        "id": "r1",\r\n        "type": "resistor",\r\n        "position": {\r\n          "x": 660,\r\n          "y": 160\r\n        },\r\n        "rotation": 0,\r\n        "props": {\r\n          "resistanceOhms": 1000\r\n        }\r\n      }\r\n    ],\r\n    "wires": [\r\n      {\r\n        "id": "w1",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "5V"\r\n        },\r\n        "to": {\r\n          "partId": "motor1",\r\n          "pinId": "plus"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w2",\r\n        "from": {\r\n          "partId": "motor1",\r\n          "pinId": "minus"\r\n        },\r\n        "to": {\r\n          "partId": "tip1",\r\n          "pinId": "collector"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w3",\r\n        "from": {\r\n          "partId": "tip1",\r\n          "pinId": "emitter"\r\n        },\r\n        "to": {\r\n          "partId": "uno",\r\n          "pinId": "GND"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w4",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "D9"\r\n        },\r\n        "to": {\r\n          "partId": "r1",\r\n          "pinId": "lead1"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w5",\r\n        "from": {\r\n          "partId": "r1",\r\n          "pinId": "lead2"\r\n        },\r\n        "to": {\r\n          "partId": "tip1",\r\n          "pinId": "base"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w6",\r\n        "from": {\r\n          "partId": "motor1",\r\n          "pinId": "plus"\r\n        },\r\n        "to": {\r\n          "partId": "d1",\r\n          "pinId": "cathode"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w7",\r\n        "from": {\r\n          "partId": "motor1",\r\n          "pinId": "minus"\r\n        },\r\n        "to": {\r\n          "partId": "d1",\r\n          "pinId": "anode"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      }\r\n    ]\r\n  },\r\n  "sketch": "// DC Motor with TIP120 transistor and flyback diode\\n// Motor + -> 5V, Motor - -> TIP120 collector\\n// TIP120 emitter -> GND, base -> D9 via 1kΩ\\n// Diode across motor (cathode to +, anode to -)\\nconst int motorPin = 9;\\n\\nvoid setup() {\\n  pinMode(motorPin, OUTPUT);\\n  Serial.begin(9600);\\n}\\n\\nvoid loop() {\\n  // Fade in\\n  for (int speed = 0; speed <= 255; speed += 5) {\\n    analogWrite(motorPin, speed);\\n    delay(20);\\n  }\\n  delay(1000);\\n  // Fade out\\n  for (int speed = 255; speed >= 0; speed -= 5) {\\n    analogWrite(motorPin, speed);\\n    delay(20);\\n  }\\n  delay(1000);\\n}\\n",\r\n  "metadata": {\r\n    "created_at": "2026-10-25T00:00:00.000Z",\r\n    "app_version": "0.5.0-beta.2"\r\n  },\r\n  "viewport": {\r\n    "scale": 1,\r\n    "offsetX": 40,\r\n    "offsetY": 40\r\n  },\r\n  "name": "Control DC motor speed"\r\n}';
//#endregion
//#region src/starters/uno-potentiometer.vcc?raw
var uno_potentiometer_default =
  '{\r\n  "format": "vircuit-project",\r\n  "version": 2,\r\n  "circuit": {\r\n    "version": 1,\r\n    "parts": [\r\n      {\r\n        "id": "uno",\r\n        "type": "arduino-uno",\r\n        "position": {\r\n          "x": 80,\r\n          "y": 120\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      },\r\n      {\r\n        "id": "pot1",\r\n        "type": "potentiometer",\r\n        "position": {\r\n          "x": 500,\r\n          "y": 160\r\n        },\r\n        "rotation": 0,\r\n        "props": {\r\n          "resistanceOhms": 10000\r\n        }\r\n      },\r\n      {\r\n        "id": "led1",\r\n        "type": "led",\r\n        "position": {\r\n          "x": 500,\r\n          "y": 260\r\n        },\r\n        "rotation": 0,\r\n        "props": {\r\n          "color": "blue"\r\n        }\r\n      },\r\n      {\r\n        "id": "r1",\r\n        "type": "resistor",\r\n        "position": {\r\n          "x": 580,\r\n          "y": 260\r\n        },\r\n        "rotation": 0,\r\n        "props": {\r\n          "resistanceOhms": 220\r\n        }\r\n      }\r\n    ],\r\n    "wires": [\r\n      {\r\n        "id": "w1",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "5V"\r\n        },\r\n        "to": {\r\n          "partId": "pot1",\r\n          "pinId": "1"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w2",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "GND"\r\n        },\r\n        "to": {\r\n          "partId": "pot1",\r\n          "pinId": "3"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w3",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "A0"\r\n        },\r\n        "to": {\r\n          "partId": "pot1",\r\n          "pinId": "2"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w4",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "D9"\r\n        },\r\n        "to": {\r\n          "partId": "r1",\r\n          "pinId": "lead1"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w5",\r\n        "from": {\r\n          "partId": "r1",\r\n          "pinId": "lead2"\r\n        },\r\n        "to": {\r\n          "partId": "led1",\r\n          "pinId": "anode"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w6",\r\n        "from": {\r\n          "partId": "led1",\r\n          "pinId": "cathode"\r\n        },\r\n        "to": {\r\n          "partId": "uno",\r\n          "pinId": "GND"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      }\r\n    ]\r\n  },\r\n  "sketch": "// Potentiometer: pins 1->5V, 3->GND, wiper (2)->A0\\n// LED brightness controlled by potentiometer on D9\\nconst int potPin = A0;\\nconst int ledPin = 9;\\n\\nvoid setup() {\\n  pinMode(ledPin, OUTPUT);\\n  Serial.begin(9600);\\n}\\n\\nvoid loop() {\\n  int potValue = analogRead(potPin);\\n  int brightness = map(potValue, 0, 1023, 0, 255);\\n  analogWrite(ledPin, brightness);\\n\\n  Serial.print(\\"Pot: \\");\\n  Serial.print(potValue);\\n  Serial.print(\\" -> Brightness: \\");\\n  Serial.println(brightness);\\n  delay(50);\\n}\\n",\r\n  "metadata": {\r\n    "created_at": "2026-10-25T00:00:00.000Z",\r\n    "app_version": "0.5.0-beta.2"\r\n  },\r\n  "viewport": {\r\n    "scale": 1,\r\n    "offsetX": 40,\r\n    "offsetY": 40\r\n  },\r\n  "name": "Control LED brightness with potentiometer"\r\n}';
