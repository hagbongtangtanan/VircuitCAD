function genericPart(type, label, category, size, pins, options = {}) {
  return {
    type,
    label,
    category,
    size,
    defaultProps: {},
    pins,
    ...options,
    propFields: options.propFields ?? [],
  };
}
function dipHeight(pinCount) {
  return Math.max(56, Math.ceil(pinCount / 2) * 12 + 16);
}
function dipPart(type, label, pinCount, labels = []) {
  const rows = Math.ceil(pinCount / 2);
  const height = dipHeight(pinCount);
  const pins = [];
  for (let row = 0; row < rows; row += 1) {
    const y = 8 + row * 12;
    const leftNumber = row + 1;
    const rightNumber = pinCount - row;
    pins.push(
      pin(String(leftNumber), labels[leftNumber - 1] ?? String(leftNumber), {
        x: 0,
        y,
      }),
    );
    if (rightNumber !== leftNumber)
      pins.push(
        pin(
          String(rightNumber),
          labels[rightNumber - 1] ?? String(rightNumber),
          {
            x: 110,
            y,
          },
        ),
      );
  }
  return genericPart(
    type,
    label,
    "boards",
    {
      width: 110,
      height,
    },
    pins,
  );
}
function gatePart(type, label, pinCount, _gates, labels) {
  return dipPart(
    type,
    label,
    pinCount,
    Array.from(
      { length: pinCount },
      (_unused, index) => labels[index] ?? String(index + 1),
    ),
  );
}
