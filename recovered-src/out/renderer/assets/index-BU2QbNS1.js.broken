  '{\r\n  "format": "vircuit-project",\r\n  "version": 2,\r\n  "circuit": {\r\n    "version": 1,\r\n    "parts": [\r\n      {\r\n        "id": "uno",\r\n        "type": "arduino-uno",\r\n        "position": {\r\n          "x": 80,\r\n          "y": 120\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      },\r\n      {\r\n        "id": "sv1",\r\n        "type": "servo",\r\n        "position": {\r\n          "x": 520,\r\n          "y": 220\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      }\r\n    ],\r\n    "wires": [\r\n      {\r\n        "id": "w1",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "D9"\r\n        },\r\n        "to": {\r\n          "partId": "sv1",\r\n          "pinId": "signal"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w2",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "5V"\r\n        },\r\n        "to": {\r\n          "partId": "sv1",\r\n          "pinId": "vcc"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w3",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "GND"\r\n        },\r\n        "to": {\r\n          "partId": "sv1",\r\n          "pinId": "gnd"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      }\r\n    ]\r\n  },\r\n  "sketch": "// Micro servo on D9. Bit-banged so the sketch needs no Servo library.\\nconst int servoPin = 9;\\n\\nvoid setup() {\\n  pinMode(servoPin, OUTPUT);\\n}\\n\\nvoid pulseServo(int angle) {\\n  int width = map(angle, 0, 180, 500, 2500);\\n  digitalWrite(servoPin, HIGH);\\n  delayMicroseconds(width);\\n  digitalWrite(servoPin, LOW);\\n  delay(20);\\n}\\n\\nvoid loop() {\\n  for (int angle = 0; angle <= 180; angle += 10) {\\n    pulseServo(angle);\\n    delay(40);\\n  }\\n  for (int angle = 180; angle >= 0; angle -= 10) {\\n    pulseServo(angle);\\n    delay(40);\\n  }\\n}\\n",\r\n  "metadata": {\r\n    "created_at": "2026-10-25T00:00:00.000Z",\r\n    "app_version": "0.5.0-beta.2"\r\n  },\r\n  "viewport": {\r\n    "scale": 1,\r\n    "offsetX": 40,\r\n    "offsetY": 40\r\n  },\r\n  "name": "Sweep a micro servo"\r\n}\r\n';
