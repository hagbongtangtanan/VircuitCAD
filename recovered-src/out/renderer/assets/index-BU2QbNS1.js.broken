var uno_gas_sensor_default =
  '{\r\n  "format": "vircuit-project",\r\n  "version": 2,\r\n  "circuit": {\r\n    "version": 1,\r\n    "parts": [\r\n      {\r\n        "id": "uno",\r\n        "type": "arduino-uno",\r\n        "position": {\r\n          "x": 80,\r\n          "y": 120\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      },\r\n      {\r\n        "id": "gs1",\r\n        "type": "gas-sensor",\r\n        "position": {\r\n          "x": 500,\r\n          "y": 160\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      }\r\n    ],\r\n    "wires": [\r\n      {\r\n        "id": "w1",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "5V"\r\n        },\r\n        "to": {\r\n          "partId": "gs1",\r\n          "pinId": "h1"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w2",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "GND"\r\n        },\r\n        "to": {\r\n          "partId": "gs1",\r\n          "pinId": "h2"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w3",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "A0"\r\n        },\r\n        "to": {\r\n          "partId": "gs1",\r\n          "pinId": "a1"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      }\r\n    ]\r\n  },\r\n  "sketch": "// Gas Sensor (MQ series): H pins -> 5V/GND (heater), A pin -> A0\\n// B pins can be used for differential measurement\\nconst int sensorPin = A0;\\n\\nvoid setup() {\\n  Serial.begin(9600);\\n  Serial.println(\\"Gas sensor warming up...\\");\\n}\\n\\nvoid loop() {\\n  int reading = analogRead(sensorPin);\\n  float voltage = reading * 5.0 / 1023.0;\\n  \\n  Serial.print(\\"Gas level: \\");\\n  Serial.print(reading);\\n  Serial.print(\\" (\\");\\n  Serial.print(voltage, 3);\\n  Serial.println(\\" V)\\");\\n  delay(1000);\\n}\\n",\r\n  "metadata": {\r\n    "created_at": "2026-10-25T00:00:00.000Z",\r\n    "app_version": "0.5.0-beta.2"\r\n  },\r\n  "viewport": {\r\n    "scale": 1,\r\n    "offsetX": 40,\r\n    "offsetY": 40\r\n  },\r\n  "name": "Detect gas with MQ sensor"\r\n}';
