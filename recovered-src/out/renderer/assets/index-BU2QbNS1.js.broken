\n        "to": {\r\n          "partId": "r1",\r\n          "pinId": "lead1"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w2",\r\n        "from": {\r\n          "partId": "r1",\r\n          "pinId": "lead2"\r\n        },\r\n        "to": {\r\n          "partId": "led1",\r\n          "pinId": "anode"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w3",\r\n        "from": {\r\n          "partId": "led1",\r\n          "pinId": "cathode"\r\n        },\r\n        "to": {\r\n          "partId": "uno",\r\n          "pinId": "GND"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w4",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "D12"\r\n        },\r\n        "to": {\r\n          "partId": "r2",\r\n          "pinId": "lead1"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w5",\r\n        "from": {\r\n          "partId": "r2",\r\n          "pinId": "lead2"\r\n        },\r\n        "to": {\r\n          "partId": "led2",\r\n          "pinId": "anode"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w6",\r\n        "from": {\r\n          "partId": "led2",\r\n          "pinId": "cathode"\r\n        },\r\n        "to": {\r\n          "partId": "uno",\r\n          "pinId": "GND2"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w7",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "D11"\r\n        },\r\n        "to": {\r\n          "partId": "r3",\r\n          "pinId": "lead1"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w8",\r\n        "from": {\r\n          "partId": "r3",\r\n          "pinId": "lead2"\r\n        },\r\n        "to": {\r\n          "partId": "led3",\r\n          "pinId": "anode"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w9",\r\n        "from": {\r\n          "partId": "led3",\r\n          "pinId": "cathode"\r\n        },\r\n        "to": {\r\n          "partId": "uno",\r\n          "pinId": "GND"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      }\r\n    ]\r\n  },\r\n  "sketch": "// Traffic light: red D13, yellow D12, green D11.\\nconst int redPin = 13;\\nconst int yellowPin = 12;\\nconst int greenPin = 11;\\n\\nvoid setup() {\\n  pinMode(redPin, OUTPUT);\\n  pinMode(yellowPin, OUTPUT);\\n  pinMode(greenPin, OUTPUT);\\n}\\n\\nvoid loop() {\\n  digitalWrite(redPin, HIGH);\\n  delay(3000);\\n  digitalWrite(redPin, LOW);\\n\\n  digitalWrite(yellowPin, HIGH);\\n  delay(1000);\\n  digitalWrite(yellowPin, LOW);\\n\\n  digitalWrite(greenPin, HIGH);\\n  delay(3000);\\n  digitalWrite(greenPin, LOW);\\n}\\n",\r\n  "metadata": {\r\n    "created_at": "2026-10-25T00:00:00.000Z",\r\n    "app_version": "0.5.0-beta.2"\r\n  },\r\n  "viewport": {\r\n    "scale": 1,\r\n    "offsetX": 40,\r\n    "offsetY": 40\r\n  },\r\n  "name": "Traffic light"\r\n}\r\n';
