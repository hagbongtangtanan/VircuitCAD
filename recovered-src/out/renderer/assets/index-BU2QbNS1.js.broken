function compactBreadboard(columns) {
  const pins = [];
  const nets = [];
  const topRows = ["a", "b", "c", "d", "e"];
  const bottomRows = ["f", "g", "h", "i", "j"];
  const pitch = 12;
  const firstX = 24;
  const width = firstX + (columns - 1) * pitch + 24;
  for (let column = 1; column <= columns; column += 1) {
    const x = firstX + (column - 1) * pitch;
    for (const [index, row] of topRows.entries())
      pins.push(
        pin(
          `${row}${column}`,
          `${row}${column}`,
          {
            x,
            y: 38 + index * 10,
          },
          "passive",
        ),
      );
    for (const [index, row] of bottomRows.entries())
      pins.push(
        pin(
          `${row}${column}`,
          `${row}${column}`,
          {
            x,
            y: 92 + index * 10,
          },
          "passive",
        ),
      );
    nets.push(topRows.map((row) => `${row}${column}`));
    nets.push(bottomRows.map((row) => `${row}${column}`));
  }
  for (const [prefix, label, y, kind] of [
    ["top-plus", "+", 12, "power"],
    ["top-minus", "-", 22, "ground"],
    ["bottom-plus", "+", 142, "power"],
    ["bottom-minus", "-", 152, "ground"],
  ]) {
    const rail = [];
    for (let column = 1; column <= columns; column += 1) {
      const id = `${prefix}-${column}`;
      pins.push(
        pin(
          id,
          label,
          {
            x: firstX + (column - 1) * pitch,
            y,
          },
          kind,
        ),
      );
      rail.push(id);
    }
    nets.push(rail);
  }
  return {
    size: {
      width,
      height: 166,
    },
    pins,
    internalNets: nets,
  };
}
