var RASPBERRY_PI_HEADER_X = 44;
var RASPBERRY_PI_HEADER_Y = 4;
var RASPBERRY_PI_HEADER_PITCH = 26;
var RASPBERRY_PI_HEADER_ROW_PITCH = 26;
function buildRaspberryPiPins() {
  return RASPBERRY_PI_HEADER_PINS.map((entry) => {
    const index = entry.physical - 1;
    return pin(
      entry.id,
      entry.label,
      {
        x:
          RASPBERRY_PI_HEADER_X +
          Math.floor(index / 2) * RASPBERRY_PI_HEADER_PITCH,
        y: RASPBERRY_PI_HEADER_Y + (index % 2) * RASPBERRY_PI_HEADER_ROW_PITCH,
      },
      entry.kind,
    );
  });
}
function raspberryPiInternalNets() {
  const idsFor = (label) =>
    RASPBERRY_PI_HEADER_PINS.filter((entry) => entry.label === label).map(
      (entry) => entry.id,
    );
  return [idsFor("3V3"), idsFor("5V"), idsFor("GND")];
}
