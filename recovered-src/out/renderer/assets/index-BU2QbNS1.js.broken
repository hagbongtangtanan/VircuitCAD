//#region src/starters/uno-thermistor.vcc?raw
var uno_thermistor_default =
  '{\r\n  "format": "vircuit-project",\r\n  "version": 2,\r\n  "circuit": {\r\n    "version": 1,\r\n    "parts": [\r\n      {\r\n        "id": "uno",\r\n        "type": "arduino-uno",\r\n        "position": {\r\n          "x": 80,\r\n          "y": 120\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      },\r\n      {\r\n        "id": "th1",\r\n        "type": "thermistor",\r\n        "position": {\r\n          "x": 500,\r\n          "y": 160\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      },\r\n      {\r\n        "id": "r1",\r\n        "type": "resistor",\r\n        "position": {\r\n          "x": 560,\r\n          "y": 160\r\n        },\r\n        "rotation": 0,\r\n        "props": {\r\n          "resistanceOhms": 10000\r\n        }\r\n      }\r\n    ],\r\n    "wires": [\r\n      {\r\n        "id": "w1",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "5V"\r\n        },\r\n        "to": {\r\n          "partId": "th1",\r\n          "pinId": "1"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w2",\r\n        "from": {\r\n          "partId": "th1",\r\n          "pinId": "2"\r\n        },\r\n        "to": {\r\n          "partId": "r1",\r\n          "pinId": "lead1"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w3",\r\n        "from": {\r\n          "partId": "r1",\r\n          "pinId": "lead2"\r\n        },\r\n        "to": {\r\n          "partId": "uno",\r\n          "pinId": "GND"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w4",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "A0"\r\n        },\r\n        "to": {\r\n          "partId": "th1",\r\n          "pinId": "2"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      }\r\n    ]\r\n  },\r\n  "sketch": "// NTC Thermistor (10k@25°C): voltage divider with 10kΩ resistor\\n// Thermistor pin 1 -> 5V, pin 2 -> A0 and 10kΩ to GND\\nconst int sensorPin = A0;\\nconst float SERIES_RESISTOR = 10000.0;\\nconst float NOMINAL_RESISTANCE = 10000.0;\\nconst float NOMINAL_TEMPERATURE = 25.0;\\nconst float B_COEFFICIENT = 3950.0;\\n\\nvoid setup() {\\n  Serial.begin(9600);\\n}\\n\\nvoid loop() {\\n  int reading = analogRead(sensorPin);\\n  float voltage = reading * 5.0 / 1023.0;\\n  float resistance = SERIES_RESISTOR * voltage / (5.0 - voltage);\\n\\n  float steinhart = resistance / NOMINAL_RESISTANCE;\\n  steinhart = log(steinhart);\\n  steinhart /= B_COEFFICIENT;\\n  steinhart += 1.0 / (NOMINAL_TEMPERATURE + 273.15);\\n  steinhart = 1.0 / steinhart;\\n  steinhart -= 273.15;\\n\\n  Serial.print(\\"Temperature: \\");\\n  Serial.print(steinhart, 1);\\n  Serial.println(\\" °C\\");\\n  delay(1000);\\n}\\n",\r\n  "metadata": {\r\n    "created_at": "2026-10-25T00:00:00.000Z",\r\n    "app_version": "0.5.0-beta.2"\r\n  },\r\n  "viewport": {\r\n    "scale": 1,\r\n    "offsetX": 40,\r\n    "offsetY": 40\r\n  },\r\n  "name": "Read temperature with thermistor"\r\n}';
//#endregion
