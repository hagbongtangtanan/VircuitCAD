          "pinId": "D10"\r\n        },\r\n        "to": {\r\n          "partId": "r2",\r\n          "pinId": "lead1"\r\n        },\r\n        "color": "#44ff44",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w4",\r\n        "from": {\r\n          "partId": "r2",\r\n          "pinId": "lead2"\r\n        },\r\n        "to": {\r\n          "partId": "rgb1",\r\n          "pinId": "green"\r\n        },\r\n        "color": "#44ff44",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w5",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "D11"\r\n        },\r\n        "to": {\r\n          "partId": "r3",\r\n          "pinId": "lead1"\r\n        },\r\n        "color": "#4444ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w6",\r\n        "from": {\r\n          "partId": "r3",\r\n          "pinId": "lead2"\r\n        },\r\n        "to": {\r\n          "partId": "rgb1",\r\n          "pinId": "blue"\r\n        },\r\n        "color": "#4444ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w7",\r\n        "from": {\r\n          "partId": "rgb1",\r\n          "pinId": "cathode"\r\n        },\r\n        "to": {\r\n          "partId": "uno",\r\n          "pinId": "GND"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      }\r\n    ]\r\n  },\r\n  "sketch": "// RGB LED (common cathode): R -> D9 (220Ω), G -> D10 (220Ω), B -> D11 (220Ω), K -> GND\\nconst int redPin = 9;\\nconst int greenPin = 10;\\nconst int bluePin = 11;\\n\\nvoid setup() {\\n  pinMode(redPin, OUTPUT);\\n  pinMode(greenPin, OUTPUT);\\n  pinMode(bluePin, OUTPUT);\\n}\\n\\nvoid setColor(int r, int g, int b) {\\n  analogWrite(redPin, r);\\n  analogWrite(greenPin, g);\\n  analogWrite(bluePin, b);\\n}\\n\\nvoid loop() {\\n  setColor(255, 0, 0); delay(500);   // Red\\n  setColor(0, 255, 0); delay(500);   // Green\\n  setColor(0, 0, 255); delay(500);   // Blue\\n  setColor(255, 255, 0); delay(500); // Yellow\\n  setColor(0, 255, 255); delay(500); // Cyan\\n  setColor(255, 0, 255); delay(500); // Magenta\\n  setColor(255, 255, 255); delay(500); // White\\n}\\n",\r\n  "metadata": {\r\n    "created_at": "2026-10-25T00:00:00.000Z",\r\n    "app_version": "0.5.0-beta.2"\r\n  },\r\n  "viewport": {\r\n    "scale": 1,\r\n    "offsetX": 40,\r\n    "offsetY": 40\r\n  },\r\n  "name": "Control RGB LED colors"\r\n}';
