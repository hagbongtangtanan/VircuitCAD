var uno_ultrasonic_default =
  '{\r\n  "format": "vircuit-project",\r\n  "version": 2,\r\n  "circuit": {\r\n    "version": 1,\r\n    "parts": [\r\n      {\r\n        "id": "uno",\r\n        "type": "arduino-uno",\r\n        "position": {\r\n          "x": 80,\r\n          "y": 120\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      },\r\n      {\r\n        "id": "us1",\r\n        "type": "ultrasonic-hcsr04",\r\n        "position": {\r\n          "x": 500,\r\n          "y": 160\r\n        },\r\n        "rotation": 0,\r\n        "props": {}\r\n      },\r\n      {\r\n        "id": "obs1",\r\n        "type": "resistor",\r\n        "position": {\r\n          "x": 400,\r\n          "y": 40\r\n        },\r\n        "rotation": 0,\r\n        "props": {\r\n          "resistanceOhms": 220\r\n        }\r\n      }\r\n    ],\r\n    "wires": [\r\n      {\r\n        "id": "w1",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "5V"\r\n        },\r\n        "to": {\r\n          "partId": "us1",\r\n          "pinId": "vcc"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w2",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "GND"\r\n        },\r\n        "to": {\r\n          "partId": "us1",\r\n          "pinId": "gnd"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w3",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "D9"\r\n        },\r\n        "to": {\r\n          "partId": "us1",\r\n          "pinId": "trig"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      },\r\n      {\r\n        "id": "w4",\r\n        "from": {\r\n          "partId": "uno",\r\n          "pinId": "D10"\r\n        },\r\n        "to": {\r\n          "partId": "us1",\r\n          "pinId": "echo"\r\n        },\r\n        "color": "#6fb3ff",\r\n        "waypoints": []\r\n      }\r\n    ]\r\n  },\r\n  "sketch": "// HC-SR04 Ultrasonic: VCC -> 5V, GND -> GND, TRIG -> D9, ECHO -> D10\\nconst int trigPin = 9;\\nconst int echoPin = 10;\\n\\nvoid setup() {\\n  pinMode(trigPin, OUTPUT);\\n  pinMode(echoPin, INPUT);\\n  Serial.begin(9600);\\n}\\n\\nvoid loop() {\\n  digitalWrite(trigPin, LOW);\\n  delayMicroseconds(2);\\n  digitalWrite(trigPin, HIGH);\\n  delayMicroseconds(10);\\n  digitalWrite(trigPin, LOW);\\n\\n  long duration = pulseInLong(echoPin, HIGH);\\n  float distance = duration * 0.034 / 2.0;\\n\\n  Serial.print(\\"Distance: \\");\\n  Serial.print(distance);\\n  Serial.println(\\" cm\\");\\n  delay(500);\\n}\\n",\r\n  "metadata": {\r\n    "created_at": "2026-10-25T00:00:00.000Z",\r\n    "app_version": "0.5.0-beta.2"\r\n  },\r\n  "viewport": {\r\n    "scale": 1,\r\n    "offsetX": 40,\r\n    "offsetY": 40\r\n  },\r\n  "name": "Measure distance with ultrasonic"\r\n}';
//#endregion
