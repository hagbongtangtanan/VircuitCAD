  "sketch": "// NeoPixel Ring (bit-bang): VDD -> 5V, GND -> GND, DIN -> D6\n// WS2812 timing without Adafruit_NeoPixel library\n#define PIN 6\n#define NUMPIXELS 12\n\nvoid sendBit(bool bitVal) {\n  if (bitVal) {\n    PORTD |= (1 << PIN);\n    __asm__ volatile (\n      \"nop\\n\\t nop\\n\\t nop\\n\\t nop\\n\\t nop\\n\\t nop\\n\\t\"\n      \"nop\\n\\t nop\\n\\t nop\\n\\t nop\\n\\t nop\\n\\t\"\n      \"nop\\n\\t nop\\n\\t nop\\n\\t nop\\n\\t nop\\n\\t\"\n    );\n    PORTD &= ~(1 << PIN);\n  } else {\n    PORTD |= (1 << PIN);\n    __asm__ volatile (\"nop\\n\\t nop\\n\\t nop\\n\\t\");\n    PORTD &= ~(1 << PIN);\n  }\n}\n\nvoid sendByte(uint8_t b) {\n  for (int i = 7; i >= 0; i--) sendBit(b & (1 << i));\n}\n\nvoid setPixel(uint8_t r, uint8_t g, uint8_t b) {\n  sendByte(g); sendByte(r); sendByte(b);\n}\n\nvoid show() {\n  PORTD &= ~(1 << PIN);\n  delayMicroseconds(50);\n}\n\nvoid setup() {\n  pinMode(PIN, OUTPUT);\n  digitalWrite(PIN, LOW);\n}\n\nvoid loop() {\n  for (int i = 0; i < NUMPIXELS; i++) {\n    setPixel(0, 0, 150);\n    show();\n    delay(50);\n    setPixel(0, 0, 0);\n    show();\n  }\n}\n",
