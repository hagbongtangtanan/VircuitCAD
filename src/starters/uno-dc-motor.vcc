  "sketch": "// DC Motor with TIP120 transistor and flyback diode\n// Motor + -> 5V, Motor - -> TIP120 collector\n// TIP120 emitter -> GND, base -> D9 via 1kΩ\n// Diode across motor (cathode to +, anode to -)\nconst int motorPin = 9;\n\nvoid setup() {\n  pinMode(motorPin, OUTPUT);\n  Serial.begin(9600);\n}\n\nvoid loop() {\n  // Fade in\n  for (int speed = 0; speed <= 255; speed += 5) {\n    analogWrite(motorPin, speed);\n    delay(20);\n  }\n  delay(1000);\n  // Fade out\n  for (int speed = 255; speed >= 0; speed -= 5) {\n    analogWrite(motorPin, speed);\n    delay(20);\n  }\n  delay(1000);\n}\n",
