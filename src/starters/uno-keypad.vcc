  "sketch": "// 4x4 Keypad (no library): Rows R1-R4 -> D2-D5, Cols C1-C4 -> D6-D9\n// Manual matrix scanning without Keypad library\nconst byte ROWS = 4;\nconst byte COLS = 4;\nchar keys[ROWS][COLS] = {\n  {'1','2','3','A'},\n  {'4','5','6','B'},\n  {'7','8','9','C'},\n  {'*','0','#','D'}\n};\nbyte rowPins[ROWS] = {2, 3, 4, 5};\nbyte colPins[COLS] = {6, 7, 8, 9};\n\nvoid setup() {\n  for (byte c = 0; c < COLS; c++) pinMode(colPins[c], OUTPUT);\n  for (byte r = 0; r < ROWS; r++) pinMode(rowPins[r], INPUT_PULLUP);\n  Serial.begin(9600);\n}\n\nvoid loop() {\n  for (byte c = 0; c < COLS; c++) {\n    digitalWrite(colPins[c], LOW);\n    for (byte r = 0; r < ROWS; r++) {\n      if (digitalRead(rowPins[r]) == LOW) {\n        Serial.print(\"Key: \");\n        Serial.println(keys[r][c]);\n        delay(300);\n      }\n    }\n    digitalWrite(colPins[c], HIGH);\n  }\n}\n",
