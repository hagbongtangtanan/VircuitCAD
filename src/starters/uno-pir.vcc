  "sketch": "// PIR Motion Sensor: VCC -> 5V, GND -> GND, OUT -> D2\n// LED on D13 indicates motion detected\nconst int pirPin = 2;\nconst int ledPin = 13;\n\nvoid setup() {\n  pinMode(pirPin, INPUT);\n  pinMode(ledPin, OUTPUT);\n  Serial.begin(9600);\n}\n\nvoid loop() {\n  int motion = digitalRead(pirPin);\n  digitalWrite(ledPin, motion);\n  if (motion) {\n    Serial.println(\"Motion detected!\");\n  }\n  delay(100);\n}\n",
