  "sketch": "// IR Receiver (raw): VCC -> 5V, GND -> GND, OUT -> D2\n// Measures raw HIGH/LOW pulse widths; protocol decoding needs IRremote library\nconst int recvPin = 2;\nunsigned long lastChange = 0;\nint lastState = HIGH;\n\nvoid setup() {\n  pinMode(recvPin, INPUT);\n  Serial.begin(9600);\n}\n\nvoid loop() {\n  int state = digitalRead(recvPin);\n  if (state != lastState) {\n    unsigned long now = micros();\n    unsigned long duration = now - lastChange;\n    if (lastState == LOW) {\n      Serial.print(\"Pulse: \");\n    } else {\n      Serial.print(\"Space: \");\n    }\n    Serial.println(duration);\n    lastChange = now;\n    lastState = state;\n  }\n}\n",
